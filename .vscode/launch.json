{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Offline integrated demo",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "--output",
        "workdir/debug-integrated-demo"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "program": "${workspaceFolder}/tools/run_integrated_demo.py"
    },
    {
      "name": "Web: uvicorn (127.0.0.1:8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "video_guide.web:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "All tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
